# Veyraxis Sentinel Environment Variables
SENTINEL_HOST=0.0.0.0
SENTINEL_PORT=8000
SENTINEL_WORKERS=1
SENTINEL_MODEL_PATH=runs/checkpoints/best.pt
SENTINEL_DEVICE=auto
SENTINEL_CONF_THRESHOLD=0.25
SENTINEL_MAX_UPLOAD_SIZE_MB=15
SENTINEL_LOG_JSON=false

# MLflow Tracking
MLFLOW_TRACKING_URI=sqlite:///mlflow.db
MLFLOW_EXPERIMENT_NAME=veyraxis-sentinel
